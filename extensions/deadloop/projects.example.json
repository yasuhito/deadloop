{
  "projects": [
    {
      "id": "example-project",
      "repoPath": "/absolute/path/to/your/repo",
      "githubRepo": "owner/repo",
      "baseBranch": "origin/main",
      "worktreeRoot": "/absolute/path/to/herdr/worktrees/example-project/",
      "autoMerge": false,
      "automationLogins": [],
      "externalReview": {
        "enabled": false,
        "waitSeconds": 1800
      },
      "automations": [
        {
          "id": "example-project:issue-coordinator",
          "name": "example-project issue coordinator",
          "schedule": "*/10 * * * *",
          "driverFile": "issue-coordinator-driver.cts"
        },
        {
          "id": "example-project:pr-reviewer",
          "name": "example-project PR reviewer",
          "schedule": "*/10 * * * *",
          "driverFile": "pr-reviewer-driver.cts"
        }
      ],
      "workerModel": "openai-codex/gpt-5.6-sol",
      "reviewerModel": "openai-codex/gpt-5.6-sol"
    }
  ]
}
